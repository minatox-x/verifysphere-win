<Window x:Class="VerifySphere.FallbackDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Open this URL in your browser"
        Width="460" Height="Auto"
        MinWidth="380"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FF1E1E2E"
        WindowStyle="SingleBorderWindow"
        ShowInTaskbar="False">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title — mirrors AlertDialog .setTitle("Open this URL in your browser") -->
        <TextBlock Grid.Row="0"
                   Text="Open this URL in your browser"
                   Foreground="#FFF1F5F9"
                   FontSize="17"
                   FontWeight="SemiBold"
                   Margin="0,0,0,16" />

        <!-- Message — mirrors .setMessage(...) -->
        <TextBlock Grid.Row="1"
                   Text="If the browser did not open automatically, copy the link below and paste it into any browser:"
                   Foreground="#FF94A3B8"
                   FontSize="13"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12" />

        <!-- URL box — scrollable, selectable, mirrors the URL text in message -->
        <Border Grid.Row="2"
                Background="#FF0F0F13"
                CornerRadius="8"
                Padding="12,10"
                Margin="0,0,0,20">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          MaxHeight="80">
                <TextBox x:Name="TbUrl"
                         IsReadOnly="True"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="#FF94A3B8"
                         FontSize="12"
                         FontFamily="Consolas, Courier New, monospace"
                         TextWrapping="Wrap"
                         Text=""
                         Focusable="True"
                         CaretBrush="Transparent"
                         SelectionBrush="#FF3B82F6" />
            </ScrollViewer>
        </Border>

        <!-- Buttons — mirrors .setPositiveButton("Copy URL") and .setNegativeButton("Close") -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button x:Name="BtnClose"
                    Content="Close"
                    Click="BtnClose_Click"
                    Style="{StaticResource TextButton}"
                    Margin="0,0,8,0" />

            <Button x:Name="BtnCopyUrl"
                    Content="Copy URL"
                    Click="BtnCopyUrl_Click"
                    Style="{StaticResource PrimaryButton}" />
        </StackPanel>
    </Grid>
</Window>
