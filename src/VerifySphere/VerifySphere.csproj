<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>VerifySphere</AssemblyName>
    <RootNamespace>VerifySphere</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- No ApplicationIcon reference — avoids restore failure when the file is absent -->
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
    <!-- PublishSingleFile / SelfContained / RuntimeIdentifier are passed at
         publish time via CLI flags so restore does not require a fixed RID. -->
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <!-- WebView2 for rendering Cloudflare Turnstile (same role as TurnstileSDK on Android) -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2592.51" />
    <!-- No extra crypto libs needed — System.Security.Cryptography is built in -->
  </ItemGroup>

</Project>
