<Application x:Class="VerifySphere.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <!-- Colours — exact match to Android colors.xml -->
        <Color x:Key="BgDarkColor">#FF0F0F13</Color>
        <Color x:Key="BgSurfaceColor">#FF1A1A24</Color>
        <Color x:Key="AccentBlueColor">#FF3B82F6</Color>
        <Color x:Key="SuccessGreenColor">#FF22C55E</Color>
        <Color x:Key="ErrorRedColor">#FFEF4444</Color>
        <Color x:Key="WarningOrangeColor">#FFF59E0B</Color>
        <Color x:Key="TextPrimaryColor">#FFF1F5F9</Color>
        <Color x:Key="TextSecondaryColor">#FF94A3B8</Color>
        <Color x:Key="DialogBgColor">#FF1E1E2E</Color>

        <SolidColorBrush x:Key="BgDark"        Color="{StaticResource BgDarkColor}" />
        <SolidColorBrush x:Key="BgSurface"     Color="{StaticResource BgSurfaceColor}" />
        <SolidColorBrush x:Key="AccentBlue"    Color="{StaticResource AccentBlueColor}" />
        <SolidColorBrush x:Key="SuccessGreen"  Color="{StaticResource SuccessGreenColor}" />
        <SolidColorBrush x:Key="ErrorRed"      Color="{StaticResource ErrorRedColor}" />
        <SolidColorBrush x:Key="WarningOrange" Color="{StaticResource WarningOrangeColor}" />
        <SolidColorBrush x:Key="TextPrimary"   Color="{StaticResource TextPrimaryColor}" />
        <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource TextSecondaryColor}" />
        <SolidColorBrush x:Key="DialogBg"      Color="{StaticResource DialogBgColor}" />
        <SolidColorBrush x:Key="White"         Color="#FFFFFFFF" />

        <!-- Button style — mirrors MaterialButton accent_blue in Android layout -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background"   Value="{StaticResource AccentBlue}" />
            <Setter Property="Foreground"   Value="{StaticResource White}" />
            <Setter Property="FontSize"     Value="15" />
            <Setter Property="FontWeight"   Value="SemiBold" />
            <Setter Property="Padding"      Value="32,12" />
            <Setter Property="Cursor"       Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF2563EB" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FF1D4ED8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary/text button for dialogs -->
        <Style x:Key="TextButton" TargetType="Button">
            <Setter Property="Background"      Value="Transparent" />
            <Setter Property="Foreground"      Value="{StaticResource AccentBlue}" />
            <Setter Property="FontSize"        Value="14" />
            <Setter Property="FontWeight"      Value="SemiBold" />
            <Setter Property="Padding"         Value="16,8" />
            <Setter Property="Cursor"          Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1A3B82F6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
