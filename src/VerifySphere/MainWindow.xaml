<Window x:Class="VerifySphere.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VerifySphere"
        Width="400" Height="500"
        MinWidth="360" MinHeight="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="{StaticResource BgDark}">

    <!-- Root — mirrors ConstraintLayout android:background="@color/bg_dark" -->
    <Grid Background="{StaticResource BgDark}">

        <!-- ================================================================
             STATE 1: WAITING / VERIFYING
             Mirrors layoutWaiting in activity_main.xml
             ================================================================ -->
        <StackPanel x:Name="LayoutWaiting"
                    Orientation="Vertical"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">

            <!-- ProgressBar — mirrors android ProgressBar with indeterminateTint=accent_blue -->
            <ProgressBar IsIndeterminate="True"
                         Width="64" Height="6"
                         Foreground="{StaticResource AccentBlue}"
                         Background="Transparent"
                         Margin="0,0,0,24"
                         HorizontalAlignment="Center" />

            <TextBlock Text="Please wait"
                       Foreground="{StaticResource TextPrimary}"
                       FontSize="22"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center" />

            <TextBlock Text="Verifying your request…"
                       Foreground="{StaticResource TextSecondary}"
                       FontSize="14"
                       Margin="0,8,0,0"
                       HorizontalAlignment="Center" />
        </StackPanel>

        <!-- ================================================================
             STATE 2: SUCCESS
             Mirrors layoutSuccess in activity_main.xml
             ================================================================ -->
        <StackPanel x:Name="LayoutSuccess"
                    Orientation="Vertical"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">

            <!-- ✓ icon — mirrors android:text="✓" with success_green -->
            <TextBlock Text="✓"
                       Foreground="{StaticResource SuccessGreen}"
                       FontSize="48"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,24" />

            <TextBlock Text="Verification Complete"
                       Foreground="{StaticResource TextPrimary}"
                       FontSize="22"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center" />

            <TextBlock Text="Opening your browser…"
                       Foreground="{StaticResource TextSecondary}"
                       FontSize="14"
                       Margin="0,8,0,0"
                       HorizontalAlignment="Center" />
        </StackPanel>

        <!-- ================================================================
             STATE 3: RETRY (soft failure — user can retry)
             Mirrors layoutRetry in activity_main.xml
             ================================================================ -->
        <StackPanel x:Name="LayoutRetry"
                    Orientation="Vertical"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="Collapsed"
                    Margin="32,0">

            <!-- ⚠ icon — mirrors android:text="⚠" with warning_orange -->
            <TextBlock Text="⚠"
                       Foreground="{StaticResource WarningOrange}"
                       FontSize="44"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,24" />

            <TextBlock x:Name="TvRetryMessage"
                       Text=""
                       Foreground="{StaticResource TextPrimary}"
                       FontSize="15"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,24" />

            <Button x:Name="BtnRetry"
                    Content="Try Again"
                    Style="{StaticResource PrimaryButton}"
                    Click="BtnRetry_Click"
                    HorizontalAlignment="Center" />
        </StackPanel>

        <!-- ================================================================
             STATE 4: ERROR (hard failure — cannot recover)
             Mirrors layoutError in activity_main.xml
             ================================================================ -->
        <StackPanel x:Name="LayoutError"
                    Orientation="Vertical"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="Collapsed"
                    Margin="32,0">

            <!-- ✕ icon — mirrors android:text="✕" with error_red -->
            <TextBlock Text="✕"
                       Foreground="{StaticResource ErrorRed}"
                       FontSize="44"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,24" />

            <TextBlock x:Name="TvErrorMessage"
                       Text=""
                       Foreground="{StaticResource TextSecondary}"
                       FontSize="14"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       LineHeight="20" />
        </StackPanel>

    </Grid>
</Window>
